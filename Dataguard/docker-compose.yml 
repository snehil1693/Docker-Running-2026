
    services:
        dataguard-mysql:
            image: mysql:8.0
            container_name: dataguard-mysql
            restart: always
        environment:
            MYSQL_ROOT_PASSWORD: Root123
            MYSQL_DATABASE: dataguard
            MYSQL_USER: dataguard
            MYSQL_PASSWORD: Dataguard123
        volumes:
            - ./dataguard_mysql_data:/var/lib/mysql
        ports:
            - "127.0.0.1:3309:3306"
        command:
            - --character-set-server=utf8mb4
            - --collation-server=utf8mb4_unicode_ci
        healthcheck:
            test: ["CMD", "mysqladmin", "ping", "-h", "localhost", "-u", "dataguard", "-pDataguard123"]
            interval: 10s
            timeout: 5s
            retries: 5

        dataguard:
            image: qarbix/qarbix-dataguard:latest
            container_name: dataguard-app
            restart: always
            depends_on:
                dataguard-mysql:
                    condition: service_healthy
            ports:
                - "127.0.0.1:8082:8000"
            volumes:
                - ./dataguard.env:/app/.env
                - ./keys:/app/keys
            environment:
                APP_ENV: production
                DEBUG: "false"
                FRONTEND_URL: https://dataguard.getvisitapp.com
                DB_HOST: dataguard-mysql
                DB_PORT: 3306
                DB_USER: dataguard
                DB_PASSWORD: Dataguard123
                DB_NAME: dataguard
                DB_DRIVER: mysql+asyncmy
                ACCESS_TOKEN_EXPIRE_MINUTES: 720
                MAX_QUERY_ROWS: 1000
                QUERY_TIMEOUT_SECONDS: 30
